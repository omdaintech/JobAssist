# Firebase configuration (required for authentication/analytics)
# Replace the values below with your own Firebase project settings.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# Flagsmith Configuration
# Auto-selects based on MODE (development vs production).
# Replace with your own Flagsmith environment IDs.
# VITE_FLAGSMITH_ENVIRONMENT_ID=YOUR_FLAGSMITH_ENVIRONMENT_ID
# Optional: Use self-hosted Flagsmith (leave empty for cloud)
# VITE_FLAGSMITH_API_URL=

# Feature Flags (Legacy - will be migrated to Flagsmith)
VITE_ENABLE_HEARING_EXAMS=true
VITE_ENABLE_SPEAKING_EXAMS=true

# reCAPTCHA (required for bot protection on public forms)
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

